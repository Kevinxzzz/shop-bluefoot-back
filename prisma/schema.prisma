// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// EMPRESA E CONFIGURAÇÕES
// -----------------------------------------------------------------------------

model Enterprise {
  id          String @id @default(uuid())
  cnpj        String @unique
  name        String
  phoneNumber String @unique @map("phone_number")

  users      User[]
  products   Product[]
  categories Category[]
  links      EnterpriseLinkGroup[]
  tokens     EnterpriseInviteToken[]
}

model EnterpriseLinkGroup {
  id   String @id @default(uuid())
  link String

  enterpriseId String     @map("empresa_id")
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  @@map("enterprise_link_group")
}

// -----------------------------------------------------------------------------
// USUÁRIOS, ACESSOS E CONVITES
// -----------------------------------------------------------------------------

model UserRole {
  id          String @id @default(uuid())
  role        String @unique // Ex: "ADMIN", "VENDEDOR"
  description String

  users User[]

  @@map("user_role")
}

model User {
  id          String  @id @default(uuid())
  name        String
  email       String  @unique
  password    String
  contactLink String? @unique @map("link_contact")

  roleId String   @map("role_id")
  role   UserRole @relation(fields: [roleId], references: [id])

  enterpriseId String     @map("enterprise_id")
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])

  createdTokens EnterpriseInviteToken[] @relation("AdminTokens")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  usedTokens UserToken[]
  products   Product[]

  @@map("users")
}

model EnterpriseInviteToken {
  id      String @id @default(uuid())
  token   String @unique
  maxUses Int    @map("max_uses")

  enterpriseId String     @map("enterprise_id")
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  createdByAdminId String @map("criado_por_admin_id")
  createdByAdmin   User   @relation("AdminTokens", fields: [createdByAdminId], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at")
  expiredAt  DateTime  @map("expired_at")
  canceledAt DateTime? @map("canceled_at")

  usedBy UserToken[]

  @@map("enterprise_invite_token")
}

model UserToken {
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenId String                @map("token_id")
  token   EnterpriseInviteToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  usedAt DateTime @default(now()) @map("used_em")

  @@id([userId, tokenId]) // Chave primária composta
  @@map("user_token")
}

// -----------------------------------------------------------------------------
// CATÁLOGO E PRODUTOS
// -----------------------------------------------------------------------------

model Category {
  id   String @id @default(uuid())
  name String
  slug String

  enterpriseId String     @map("enterprise_id")
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  products ProductCategory[]

  @@unique([enterpriseId, slug]) // Garante que o slug não se repita na mesma empresa
  @@map("category")
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Int? // Valor armazenado em centavos
  countViews  Int     @default(0) @map("count_views")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  enterpriseId String     @map("enterprise_id")
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  soldAt    DateTime? @map("sold_at")
  deletedAt DateTime? @map("deletado_at")

  media      ProductMedia[]
  categories ProductCategory[]

  @@map("product")
}

model ProductCategory {
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([categoryId, productId]) // Tabela associativa com chave composta
  @@map("product_category")
}

enum MediaType {
  FOTO
  VIDEO
}

model ProductMedia {
  id     String    @id @default(uuid())
  url    String
  type   MediaType
  isMain Boolean   @default(false) @map("is_main")
  order  Int       @default(0) @map("order")

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_media")
}
