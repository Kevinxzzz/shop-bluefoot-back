generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Enterprise {
  id          String                  @id @default(uuid())
  cnpj        String                  @unique
  name        String
  phoneNumber String                  @unique @map("phone_number")
  categories  Category[]
  tokens      EnterpriseInviteToken[]
  links       EnterpriseLinkGroup[]
  products    Product[]
  users       User[]
}

model EnterpriseLinkGroup {
  id           String     @id @default(uuid())
  link         String
  enterpriseId String     @map("empresa_id")
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)

  @@map("enterprise_link_group")
}

model UserRole {
  id          String @id @default(uuid())
  role        String @unique
  description String
  users       User[]

  @@map("user_role")
}

model User {
  id            String                  @id @default(uuid())
  name          String
  email         String                  @unique
  password      String
  profileImageUrl String?
  profileImageKey String?
  contactLink   String?                 @unique @map("link_contact")
  roleId        String                  @map("role_id")
  enterpriseId  String                  @map("enterprise_id")
  createdAt     DateTime                @default(now()) @map("created_at")
  deletedAt     DateTime?               @map("deleted_at")
  createdTokens EnterpriseInviteToken[] @relation("AdminTokens")
  products      Product[]
  usedTokens    UserToken[]
  enterprise    Enterprise              @relation(fields: [enterpriseId], references: [id])
  role          UserRole                @relation(fields: [roleId], references: [id])

  @@map("users")
}

model EnterpriseInviteToken {
  id               String      @id @default(uuid())
  token            String      @unique
  maxUses          Int         @map("max_uses")
  enterpriseId     String      @map("enterprise_id")
  createdByAdminId String      @map("criado_por_admin_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  expiredAt        DateTime    @map("expired_at")
  canceledAt       DateTime?   @map("canceled_at")
  createdByAdmin   User        @relation("AdminTokens", fields: [createdByAdminId], references: [id])
  enterprise       Enterprise  @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  usedBy           UserToken[]

  @@index([enterpriseId, canceledAt])
  @@map("enterprise_invite_token")
}

model UserToken {
  userId  String                @map("user_id")
  tokenId String                @map("token_id")
  usedAt  DateTime              @default(now()) @map("used_em")
  token   EnterpriseInviteToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tokenId])
  @@map("user_token")
}

model Category {
  id           String            @id @default(uuid())
  name         String
  slug         String
  enterpriseId String            @map("enterprise_id")
  deletedAt    DateTime?         @map("deleted_at")
  enterprise   Enterprise        @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  products     ProductCategory[]

  @@unique([enterpriseId, slug])
  @@map("category")
}

model Product {
  id           String            @id @default(uuid())
  name         String
  description  String?
  price        Int?
  countViews   Int               @default(0) @map("count_views")
  userId       String            @map("user_id")
  enterpriseId String            @map("enterprise_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  soldAt       DateTime?         @map("sold_at")
  deletedAt    DateTime?         @map("deletado_at")
  enterprise   Enterprise        @relation(fields: [enterpriseId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  categories   ProductCategory[]
  media        ProductMedia[]

  @@map("product")
}

model ProductCategory {
  categoryId String   @map("category_id")
  productId  String   @map("product_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([categoryId, productId])
  @@map("product_category")
}

model ProductMedia {
  id        String    @id @default(uuid())
  url       String
  key       String
  type      MediaType
  isMain    Boolean   @default(false) @map("is_main")
  order     Int       @default(0) @map("order")
  productId String    @map("product_id")
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_media")
}

enum MediaType {
  FOTO
  VIDEO
}
